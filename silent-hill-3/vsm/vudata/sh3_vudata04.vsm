    /* 0007F8 F80F0252FF020000 */  NOP                                    /* | */  IBNE       vi02, vi01, Apply_loop
    /* 000800 7D2BC381FF020000 */  NOP                                    /* | */  SQI.xyz    vf05, (vi03++)

