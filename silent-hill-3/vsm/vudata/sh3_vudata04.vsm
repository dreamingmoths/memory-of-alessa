    /* 0007A8 0108E101FF020000 */  NOP                                    /* | */  LQ.xyzw    vf01,   1(vi01)
    /* 0007B0 02080110FF020000 */  NOP                                    /* | */  IADDIU     vi01, vi01, 2
    /* 0007B8 32000380FF020000 */  NOP                                    /* | */  IADDI      vi03, vi00, 0

  Apply_loop:
    /* 0007C0 3C0300803D21C501 */  ITOF4.xyz    vf05, vf04                /* | */  NOP
